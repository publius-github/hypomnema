# Editor defaults for the repo (https://editorconfig.org). There is no
# formatter for TypeScript here - this keeps the basics consistent.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,kts}]
indent_size = 4

[*.md]
# two trailing spaces are a Markdown line break
trim_trailing_whitespace = false
