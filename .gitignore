# Dependencies
node_modules/

# Build outputs
dist/
src-tauri/target/
releases/
*.log

# Generated by the Tauri CLI. gen/schemas comes from the capabilities on
# every build; gen/android is recreated by `tauri android init` from
# tauri.conf.json, and the CLI rewrites parts of it (tauri.settings.gradle,
# app/tauri.build.gradle.kts) on every build as plugins change. Nothing
# in it is hand-edited: scripts/android/build-android.sh writes what a
# build needs there (docs/android/ARCHITECTURE.md).
src-tauri/gen/schemas/
src-tauri/gen/android/

# Secrets and signing material. The Tauri updater key lives outside the
# repo (~/.tauri/hypomnema.key); a keystore or its passwords put anywhere
# in the tree must not be committed either - losing control of a signing
# key is the one build mistake that cannot be undone.
.env
.env.*
*.env
*.key
*.pem
*.pfx
*.p12
*.jks
*.keystore
keystore.properties

# Test coverage
coverage/

# Editors and OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.vs/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Per-machine notes for Claude Code
CLAUDE.local.md
.claude/settings.local.json
