<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No storage permissions declared on purpose: the whole point of this
      spike is proving SAF (ACTION_OPEN_DOCUMENT_TREE + persistable URI
      permissions) works without READ/WRITE_EXTERNAL_STORAGE, which is the
      model ROADMAP.md's FilesystemSyncProvider would ship with.
    -->
    <application
        android:allowBackup="false"
        android:label="Hypomnema SAF Spike"
        android:theme="@style/Theme.AppCompat.DayNight">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
