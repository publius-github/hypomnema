<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The home-screen widgets: every list with its open count
             (ListWidgetProvider) and today's tasks (DayWidgetProvider). -->
        <receiver
            android:name="com.hypomnema.widget.ListWidgetProvider"
            android:exported="true"
            android:label="@string/hw_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hw_widget_info" />
        </receiver>
        <receiver
            android:name="com.hypomnema.widget.DayWidgetProvider"
            android:exported="true"
            android:label="@string/hw_day_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hw_day_widget_info" />
        </receiver>
        <service
            android:name="com.hypomnema.widget.ListWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
