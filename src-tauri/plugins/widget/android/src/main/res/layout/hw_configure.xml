<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hw_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:text="@string/hw_choose_list"
        android:textColor="@color/hw_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/hw_lists"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/hw_line"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/hw_configure_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hw_no_data"
        android:textColor="@color/hw_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hw_open_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/hw_button_bg"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="@string/hw_open_app"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
