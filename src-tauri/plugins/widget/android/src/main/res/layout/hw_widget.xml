<?xml version="1.0" encoding="utf-8"?>
<!-- The background is an ImageView under the content rather than the
     root's background: a tinted drawable keeps its corners, while the
     one background setter RemoteViews allows paints a flat colour. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/hw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/hw_widget_bg"
        android:tint="@color/hw_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hw_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="36dp"
                android:gravity="center_vertical"
                android:textColor="@color/hw_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hw_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/hw_muted"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/hw_add"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/hw_add"
                android:padding="8dp"
                android:src="@drawable/hw_plus"
                android:tint="@color/hw_muted" />
        </LinearLayout>

        <ListView
            android:id="@+id/hw_tasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent" />

        <TextView
            android:id="@+id/hw_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingEnd="8dp"
            android:textColor="@color/hw_muted"
            android:textSize="15sp"
            android:text="@string/hw_empty" />
    </LinearLayout>
</FrameLayout>
