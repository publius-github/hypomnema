<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hw_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:paddingEnd="8dp"
    android:paddingBottom="5dp">

    <!-- an ImageView, not a View: RemoteViews inflates only the widget
         classes it allows, and a plain View fails the whole row -->
    <ImageView
        android:id="@+id/hw_priority"
        android:layout_width="3dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:background="@color/hw_accent"
        android:contentDescription="@null"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hw_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/hw_text"
        android:textSize="14sp" />
</LinearLayout>
