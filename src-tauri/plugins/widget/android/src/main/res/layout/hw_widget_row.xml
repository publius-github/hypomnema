<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hw_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp">

    <!-- in a list card the row sits on the card's surface; on the today
         widget this stays gone and the row shows the widget's own -->
    <ImageView
        android:id="@+id/hw_row_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/hw_fill"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <!-- the status box: the drawable is the coloured square with
                 its white mark, tinted with the status colour -->
            <ImageView
                android:id="@+id/hw_status"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/hw_status_done"
                android:visibility="gone" />

            <!-- an ImageView, not a View: RemoteViews inflates only the widget
                 classes it allows, and a plain View fails the whole row -->
            <ImageView
                android:id="@+id/hw_priority"
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/hw_fill"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hw_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/hw_text"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/hw_rule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/hw_fill" />
    </LinearLayout>
</FrameLayout>
